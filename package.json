{
    "name": "lor-card-generator",
    "version": "2.0.0",
    "author": "Stiggu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stiggu/LoR-Card-Generator.git"
    },
    "description": "Library of Ruina Card Generator",
    "main": "./dist/index.js",
    "bin": {
        "lor-card": "dist/infrastructure/cli.js"
    },
    "files": [
        "./assets",
        "./dist"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "type": "module",
    "scripts": {
        "build": "tsc",
        "generate": "node --loader ts-node/esm ./src/index.ts --cost 5 --type red --name Test --attacks slash/slash/counter-slash/counter-block --range mass --image ./assets/ryoshu.png"
    },
    "dependencies": {
        "chalk": "^5.3.0",
        "commander": "^12.1.0",
        "jimp": "^1.6.0",
        "sharp": "^0.33.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.11.1",
        "@types/eslint__js": "^8.42.3",
        "@types/node": "^24.19.2",
        "eslint": "^9.11.1",
        "prettier": "^3.3.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.7.0"
    },
    "keywords": [
        "library-of-ruina",
        "project-moon"
    ]
}
